{
  "name": "company-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @company/* dev",
    "dev:infra": "docker compose -f infrastructure/compose.yml up -d",
    "build": "pnpm -r --filter @company/* build",
    "build:web": "pnpm --filter @company/employee-portal build",
    "typecheck": "pnpm -r --filter @company/* typecheck",
    "lint": "pnpm exec eslint apps packages",
    "test:unit": "node --test tests/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "db:migrate": "node scripts/not-implemented.mjs db:migrate",
    "db:seed": "node scripts/not-implemented.mjs db:seed",
    "test:integration": "node scripts/not-implemented.mjs test:integration",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e",
    "test:smoke": "node scripts/not-implemented.mjs test:smoke"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.38.0",
    "@eslint/js": "9.38.0",
    "typescript-eslint": "8.46.2",
    "@types/node": "22.18.9",
    "@nestjs/cli": "11.0.10"
  }
}
